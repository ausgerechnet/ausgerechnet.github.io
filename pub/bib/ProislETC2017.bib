 date = {2017-06-18},
 editor = {McCrae, J. and Bond, F. and Buitelaar, P. and Cimiano, P. and Declerck, T. and Gracia, J. and Kernerman, I. and Ponsoda, E. and Ordan, N. and Piasecki, M.},
 month = {August},
 note = {SharedTask},
 pages = {94–102},
